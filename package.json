{
  "name": "tasknotes-timer-pane",
  "version": "0.5.0",
  "private": true,
  "description": "Stage tasks and control regular task timers.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "deploy": "node esbuild.config.mjs deploy",
    "vault:setup": "node scripts/vault-switch.mjs setup",
    "vault:local": "node scripts/vault-switch.mjs local",
    "vault:release": "node scripts/vault-switch.mjs release",
    "vault:status": "node scripts/vault-switch.mjs status",
    "vault:undo": "node scripts/vault-switch.mjs undo",
    "test:vault-switch": "node --test scripts/vault-switch.test.mjs",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --dir tests",
    "check": "npm run build && npm run lint && npm test && npm run test:vault-switch",
    "seed": "node scripts/seed-dev-vault.mjs",
    "uat:start": "pwsh -NoProfile -File scripts/uat/start-uat-obsidian.ps1",
    "uat:stop": "pwsh -NoProfile -File scripts/uat/stop-uat-obsidian.ps1",
    "uat:smoke": "pwsh -NoProfile -File scripts/uat/smoke-uat-obsidian.ps1",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "obsidian": "1.14.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
