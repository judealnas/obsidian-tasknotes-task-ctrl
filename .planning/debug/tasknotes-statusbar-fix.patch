+++ b/e2e/issues/status-bar-tracking-refresh.spec.ts
@@ -0,0 +1,46 @@
+import { test, expect } from "@playwright/test";
+import { launchObsidian, closeObsidian, ObsidianApp } from "../obsidian";
+
+// Regression reported by TaskNotes Task Control beta testing; no upstream issue number yet.
+test.describe("tracked-task status bar refresh", () => {
+	let app: ObsidianApp;
+	let path: string | undefined;
+
+	test.beforeAll(async () => { app = await launchObsidian(); });
+	test.afterAll(async () => {
+		if (app && path) await app.page.evaluate(async (taskPath) => {
+			const api = (window as any).app.plugins.getPlugin("tasknotes").api;
+			if ((await api.time.active()).some((item: any) => item.taskPath === taskPath)) {
+				await api.time.stop(taskPath);
+			}
+			await api.tasks.update(taskPath, { archived: true });
+		}, path);
+		if (app) await closeObsidian(app);
+	});
+
+	test("shows starts and hides stops inside the former five-second cache window", async () => {
+		path = await app.page.evaluate(async () => {
+			const api = (window as any).app.plugins.getPlugin("tasknotes").api;
+			await api.lifecycle.ready();
+			if ((await api.time.active()).length) throw new Error("Test vault has unrelated timers");
+			if (!api.settings.snapshot().showTrackedTasksInStatusBar) {
+				throw new Error("Enable tracked-task status display in the isolated test-vault fixture");
+			}
+			return (await api.tasks.create({ title: `status-bar-refresh-${Date.now()}`, status: "open" })).path;
+		});
+		const status = app.page.locator(".tasknotes-status-bar:not(.tasknotes-pomodoro-status)");
+		// Let task creation prime the old implementation's empty-result cache.
+		await app.page.waitForTimeout(350);
+		for (let cycle = 0; cycle < 2; cycle++) {
+			await app.page.evaluate(async (taskPath) => {
+				await (window as any).app.plugins.getPlugin("tasknotes").api.time.start(taskPath, {});
+			}, path);
+			await expect(status).toBeVisible({ timeout: 1500 });
+			await expect(status.locator(".tasknotes-status-text")).toHaveText(/\(0:0[01]\)$/);
+			await app.page.evaluate(async (taskPath) => {
+				await (window as any).app.plugins.getPlugin("tasknotes").api.time.stop(taskPath);
+			}, path);
+			await expect(status).toBeHidden({ timeout: 1500 });
+		}
+	});
+});
