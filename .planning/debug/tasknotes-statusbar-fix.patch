diff --git a/tests/unit/issues/status-bar-tracking-refresh.test.ts b/tests/unit/issues/status-bar-tracking-refresh.test.ts
new file mode 100644
index 0000000..039afeb
--- /dev/null
+++ b/tests/unit/issues/status-bar-tracking-refresh.test.ts
@@ -0,0 +1,93 @@
+jest.mock("../../../src/modals/TaskSelectorWithCreateModal", () => ({
+	openTaskSelector: jest.fn(),
+}));
+import { StatusBarService } from "../../../src/ui/StatusBarService";
+
+describe("status bar refresh after time tracking changes", () => {
+	let service: StatusBarService;
+	let element: HTMLElement;
+	let tasks: Array<{ title: string; path: string; timeEntries: Array<{ startTime: string }> }>;
+	let readTasks: jest.Mock;
+	const tracked = (startTime = new Date().toISOString()) => ({
+		title: "Tracking fixture",
+		path: "Tasks/tracking-fixture.md",
+		timeEntries: [{ startTime }],
+	});
+	const flush = async () => {
+		await Promise.resolve();
+		await Promise.resolve();
+		await Promise.resolve();
+	};
+	const refresh = async () => {
+		service.requestUpdate();
+		await jest.advanceTimersByTimeAsync(100);
+		await flush();
+	};
+	const visible = () => !element.classList.contains("tn-static-display-none-6b99de8b");
+
+	beforeEach(() => {
+		jest.useFakeTimers();
+		jest.setSystemTime(new Date("2026-11-15T12:00:00Z"));
+		tasks = [];
+		element = document.createElement("div");
+		Object.assign(element, {
+			addClass: (...classes: string[]) => element.classList.add(...classes),
+		});
+		readTasks = jest.fn(() => tasks);
+		service = new StatusBarService({
+			settings: { showTrackedTasksInStatusBar: true, showPomodoroInStatusBar: false },
+			i18n: { translate: () => "Stop active time tracking" },
+			addStatusBarItem: () => element,
+			cacheManager: { getAllCachedTasks: readTasks },
+			getActiveTimeSession: (task: ReturnType<typeof tracked>) => task.timeEntries[0] ?? null,
+		} as never);
+	});
+
+	afterEach(() => {
+		service.destroy();
+		jest.useRealTimers();
+	});
+
+	it("shows a newly started timer even when the previous empty result is less than five seconds old", async () => {
+		service.initialize();
+		await flush();
+		expect(visible()).toBe(false);
+		tasks = [tracked()];
+		await refresh();
+		expect(visible()).toBe(true);
+		expect(element.textContent).toContain("Tracking: Tracking fixture");
+	});
+
+	it("hides tracking immediately after the last timer stops", async () => {
+		tasks = [tracked()];
+		service.initialize();
+		await flush();
+		expect(visible()).toBe(true);
+		tasks = [];
+		await refresh();
+		expect(visible()).toBe(false);
+		await jest.advanceTimersByTimeAsync(1000);
+		expect(visible()).toBe(false);
+	});
+
+	it("uses the new active entry timestamp after a rapid restart", async () => {
+		tasks = [tracked("2026-11-15T11:59:00Z")];
+		service.initialize();
+		await flush();
+		expect(element.textContent).toContain("1:00");
+		tasks = [tracked()];
+		await refresh();
+		expect(element.textContent).toContain("(0:00)");
+	});
+
+	it("continues to debounce a burst of refresh requests into one fresh task read", async () => {
+		service.initialize();
+		await flush();
+		readTasks.mockClear();
+		service.requestUpdate();
+		service.requestUpdate();
+		service.requestUpdate();
+		await jest.advanceTimersByTimeAsync(100);
+		expect(readTasks).toHaveBeenCalledTimes(1);
+	});
+});
